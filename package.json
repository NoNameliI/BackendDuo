{
  "name": "pg-interactive-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/pyodide/prepare.mjs",
    "dev": "vite",
    "prebuild": "node scripts/pyodide/prepare.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/pyodide/prepare.mjs",
    "test": "vitest run",
    "prevalidate:content": "node scripts/pyodide/prepare.mjs",
    "validate:content": "vitest run --config vitest.content.config.ts",
    "dist": "node scripts/dist.mjs",
    "pack:private": "node scripts/run-pack-private.mjs",
    "audit:visual": "node scripts/audit-visual.mjs",
    "tauri": "tauri",
    "test:git-parity": "vitest run --config vitest.git-parity.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "diff": "^9.0.0",
    "graphql": "^17.1.0",
    "marked": "^18.1.3",
    "monaco-editor": "^0.57.0",
    "node-diff3": "^3.2.1",
    "protobufjs": "^8.8.1",
    "pyodide": "314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
