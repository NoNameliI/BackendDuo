{
  "baseUrl": "https://api.shop.local",
  "collections": {
    "categories": [
      { "id": 1, "name": "Ноутбуки", "slug": "laptops" },
      { "id": 2, "name": "Смартфоны", "slug": "phones" },
      { "id": 3, "name": "Аксессуары", "slug": "accessories" }
    ],
    "products": [
      { "id": 1, "name": "Ноутбук Альфа 13", "category_id": 1, "price": 89990, "stock": 5 },
      { "id": 2, "name": "Ноутбук Бета 15", "category_id": 1, "price": 74990, "stock": 3 },
      { "id": 3, "name": "Смартфон Гамма", "category_id": 2, "price": 39990, "stock": 12 },
      { "id": 4, "name": "Смартфон Дельта мини", "category_id": 2, "price": 24990, "stock": 0 },
      { "id": 5, "name": "Наушники Эхо", "category_id": 3, "price": 5990, "stock": 20 },
      { "id": 6, "name": "Чехол для смартфона", "category_id": 3, "price": 990, "stock": 50 },
      { "id": 7, "name": "Зарядка 65 Вт", "category_id": 3, "price": 2990, "stock": 15 },
      { "id": 8, "name": "Смартфон Омега Про", "category_id": 2, "price": 59990, "stock": 7 }
    ],
    "customers": [
      { "id": 1, "name": "Анна Смирнова", "email": "anna@example.com", "city": "Казань" },
      { "id": 2, "name": "Борис Ковалёв", "email": "boris@example.com", "city": "Москва" },
      { "id": 3, "name": "Вера Лебедева", "email": "vera@example.com", "city": "Казань" }
    ],
    "orders": [
      { "id": 1, "customer_id": 1, "status": "delivered", "total": 95980, "created_at": "2026-09-02" },
      { "id": 2, "customer_id": 2, "status": "paid", "total": 39990, "created_at": "2026-09-14" },
      { "id": 3, "customer_id": 1, "status": "new", "total": 5990, "created_at": "2026-10-01" },
      { "id": 4, "customer_id": 3, "status": "paid", "total": 25980, "created_at": "2026-10-03" },
      { "id": 5, "customer_id": 2, "status": "new", "total": 990, "created_at": "2026-10-10" },
      { "id": 6, "customer_id": 1, "status": "paid", "total": 2990, "created_at": "2026-10-12" },
      { "id": 7, "customer_id": 1, "status": "shipped", "total": 74990, "created_at": "2026-10-20" }
    ]
  },
  "auth": { "tokens": ["demo-token-123"] },
  "routes": [
    { "method": "GET", "path": "/", "action": "static", "respond": { "status": 200, "body": { "status": "ok" } } },

    {
      "method": "GET",
      "path": "/categories",
      "action": "list",
      "collection": "categories"
    },
    { "method": "GET", "path": "/categories/{id}", "action": "get", "collection": "categories" },
    {
      "method": "POST",
      "path": "/categories",
      "action": "create",
      "collection": "categories",
      "unique": "slug",
      "body": {
        "name": { "type": "string", "required": true, "minLength": 1 },
        "slug": { "type": "string", "required": true, "minLength": 1 }
      }
    },
    { "method": "DELETE", "path": "/categories/{id}", "action": "delete", "collection": "categories" },

    {
      "method": "GET",
      "path": "/products",
      "action": "list",
      "collection": "products",
      "filters": ["category_id"],
      "sort": true,
      "paginate": true,
      "query": {
        "limit": { "type": "integer", "min": 1, "max": 100 },
        "page": { "type": "integer", "min": 1 }
      }
    },
    { "method": "GET", "path": "/products/{id}", "action": "get", "collection": "products" },
    {
      "method": "POST",
      "path": "/products",
      "action": "create",
      "collection": "products",
      "body": {
        "name": { "type": "string", "required": true, "minLength": 1 },
        "category_id": { "type": "integer", "required": true, "min": 1 },
        "price": { "type": "integer", "required": true, "min": 0 },
        "stock": { "type": "integer", "required": true, "min": 0 }
      }
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "action": "replace",
      "collection": "products",
      "body": {
        "name": { "type": "string", "required": true, "minLength": 1 },
        "category_id": { "type": "integer", "required": true, "min": 1 },
        "price": { "type": "integer", "required": true, "min": 0 },
        "stock": { "type": "integer", "required": true, "min": 0 }
      }
    },
    {
      "method": "PATCH",
      "path": "/products/{id}",
      "action": "update",
      "collection": "products",
      "body": {
        "name": { "type": "string", "minLength": 1 },
        "category_id": { "type": "integer", "min": 1 },
        "price": { "type": "integer", "min": 0 },
        "stock": { "type": "integer", "min": 0 }
      }
    },
    { "method": "DELETE", "path": "/products/{id}", "action": "delete", "collection": "products" },

    {
      "method": "GET",
      "path": "/customers",
      "action": "list",
      "collection": "customers",
      "filters": ["city"]
    },
    { "method": "GET", "path": "/customers/{id}/orders", "action": "list", "collection": "orders", "parent": { "collection": "customers", "field": "customer_id" } },
    { "method": "GET", "path": "/customers/{id}", "action": "get", "collection": "customers" },
    {
      "method": "POST",
      "path": "/customers",
      "action": "create",
      "collection": "customers",
      "unique": "email",
      "body": {
        "name": { "type": "string", "required": true, "minLength": 1 },
        "email": { "type": "string", "required": true, "minLength": 3 },
        "city": { "type": "string" }
      }
    },
    {
      "method": "PATCH",
      "path": "/customers/{id}",
      "action": "update",
      "collection": "customers",
      "body": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "city": { "type": "string" }
      }
    },
    {
      "method": "DELETE",
      "path": "/customers/{id}",
      "action": "static",
      "auth": true,
      "respond": { "status": 403, "body": { "detail": "Not enough permissions" } }
    },
    {
      "method": "GET",
      "path": "/me",
      "action": "static",
      "auth": true,
      "respond": { "status": 200, "body": { "id": 1, "name": "Анна Смирнова", "email": "anna@example.com", "city": "Казань" } }
    },

    {
      "method": "GET",
      "path": "/orders",
      "action": "list",
      "collection": "orders",
      "filters": ["customer_id", "status"],
      "sort": true,
      "paginate": true,
      "query": {
        "limit": { "type": "integer", "min": 1, "max": 100 },
        "page": { "type": "integer", "min": 1 },
        "status": { "type": "string", "enum": ["new", "paid", "shipped", "delivered", "cancelled"] }
      }
    },
    { "method": "GET", "path": "/orders/{id}", "action": "get", "collection": "orders" },
    {
      "method": "PATCH",
      "path": "/orders/{id}",
      "action": "update",
      "collection": "orders",
      "body": {
        "status": { "type": "string", "required": true, "enum": ["new", "paid", "shipped", "delivered", "cancelled"] }
      }
    },

    {
      "method": "GET",
      "path": "/v1/products",
      "action": "list",
      "collection": "products",
      "filters": ["category_id"],
      "sort": true,
      "paginate": true,
      "query": {
        "limit": { "type": "integer", "min": 1, "max": 100 },
        "page": { "type": "integer", "min": 1 }
      }
    },
    { "method": "GET", "path": "/v1/products/{id}", "action": "get", "collection": "products" },
    {
      "method": "GET",
      "path": "/v2/products/3",
      "action": "static",
      "respond": {
        "status": 200,
        "body": {
          "id": 3,
          "title": "Смартфон Гамма",
          "category": { "id": 2, "slug": "phones" },
          "price": { "amount": 39990, "currency": "RUB" },
          "in_stock": true
        }
      }
    },
    {
      "method": "GET",
      "path": "/v1/orders",
      "action": "list",
      "collection": "orders",
      "filters": ["customer_id", "status"],
      "sort": true,
      "paginate": true,
      "query": {
        "limit": { "type": "integer", "min": 1, "max": 100 },
        "page": { "type": "integer", "min": 1 },
        "status": { "type": "string", "enum": ["new", "paid", "shipped", "delivered", "cancelled"] }
      }
    },
    { "method": "GET", "path": "/v1/orders/{id}", "action": "get", "collection": "orders" }
  ]
}
